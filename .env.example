# ==============================================================================
# FRIDAY AI BACKEND CONFIGURATION
# Safe defaults for local-first deployment. No secrets contained.
# ==============================================================================

# Core Application
APP_NAME=FRIDAY-AI-Backend
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///friday.db

# Ollama / Local AI
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=gemma4:12b
OLLAMA_REQUEST_TIMEOUT=120.0

# Cloud AI (Opt-in only - strictly disabled by default)
CLOUD_AI_ENABLED=false
CLOUD_PROVIDER=
CLOUD_API_KEY=
CLOUD_MODEL=

# Security & Permissions
MAX_INPUT_LENGTH=32768
MAX_ORCHESTRATION_STEPS=10
COMMAND_TIMEOUT_SECONDS=30.0
APPROVED_ROOTS=["/Users/dsceimaclab03/Downloads/DB-FRIDAY"]
ALLOWED_COMMANDS=["git", "pytest", "ruff", "python3", "ls", "pwd"]

# Scheduler & Background Workers
SCHEDULER_ENABLED=true
MAX_CONCURRENT_TASKS=5

# GitHub Integration (Optional)
GITHUB_TOKEN=
